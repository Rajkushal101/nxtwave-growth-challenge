# Production & Development Environment Configuration Template
# IMPORTANT: Use placeholder values only. NEVER commit real secrets or API keys.

# Environment Mode: 'development' | 'production' | 'staging'
ENVIRONMENT=production

# Application & Security
PROJECT_NAME="NxtWave Growth Challenge — What AI Project Should You Build?"
SECRET_KEY=your-production-secret-key-min-32-chars
PORT=8000
HOST="0.0.0.0"

# Database Configuration
# Local/Demo: sqlite+aiosqlite:///./growth_challenge.db
# Production Recommendation: Managed PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://dbuser:strongpassword@dbhost:5432/nxtwave_growth
DATABASE_URL="sqlite+aiosqlite:///./growth_challenge.db"

# AI Personalization Service (Optional — 24-entry deterministic matrix functions with zero API keys)
GEMINI_API_KEY=your-gemini-api-key
AI_MODEL_NAME="gemini-1.5-flash"

# CORS Configuration (Comma-separated allowed origins for production frontend)
# Example: https://ai-project-matcher.nxtwave.co,https://growth-challenge.nxtwave.co
CORS_ORIGINS=https://your-production-domain.com,http://localhost:5173

# Campaign & Planning Constants (Planning Model)
TARGET_REGISTRATIONS=500
CAMPAIGN_BUDGET=2000
